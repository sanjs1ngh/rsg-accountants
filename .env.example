# Copy to .env.local and fill in. None of these are required to run the site
# locally — without them the contact form validates and logs instead of sending.

# ── Contact form email delivery (https://resend.com) ──────────────────────────
# 1. Create a Resend account and verify your sending domain (rsgllp.co.uk).
# 2. Create an API key and paste it below.
RESEND_API_KEY=

# Inbox that receives enquiries. Defaults to info@rsgllp.co.uk if unset.
CONTACT_TO_EMAIL=info@rsgllp.co.uk

# Verified sender. MUST be on a domain verified in Resend.
# For quick testing you can use: RSG Accountants <onboarding@resend.dev>
CONTACT_FROM_EMAIL=RSG Accountants <enquiries@rsgllp.co.uk>

# ── Optional: Google Maps ─────────────────────────────────────────────────────
# The office map works with no key (keyless embed). Only set this if you switch
# to the fully styleable Google Maps Embed API in src/components/office-map.tsx.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
